            <COMP relation="Descriptor">
              <OBJECT>
                <ID name="" mc="Infrastructure.Note" uid="656bddb0-bc9f-4cf0-87a6-099fbe9a9edf"/>
                <ATTRIBUTES>
                  <ATT name="Content"><![CDATA[tCliente cliente = null;

BDConexion miConexion = new BDConexion();
Connection conexion = miConexion.getConnection();

if (conexion != null) {
	try {
		String query = "SELECT id, nombre, dni, email, contrasenya, activo FROM usuario WHERE id = ?";
		PreparedStatement pst = conexion.prepareStatement(query);
		pst.setString(1, dni);
		
		ResultSet rs = pst.executeQuery();
		
		if (rs.next()) {
            String nombre = rs.getString("nombre");
            String contrasenya = rs.getString("contrasenya");
            boolean activo = rs.getBoolean("activo");
            
            cliente = new tCliente(dni, nombre, contrasenya, activo);
		}
		rs.close();
		pst.close();
		
	} catch(SQLException e) {
		e.printStackTrace();
	} finally {
		miConexion.desconectar();
	}
}]]></ATT>
